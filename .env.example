NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://courier:YOUR_DATABASE_PASSWORD@127.0.0.1:55432/courier
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
DIRECT_URL=
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ADMIN_EMAIL=admin@courier.example
ADMIN_PASSWORD=REPLACE_WITH_DEDICATED_ADMIN_PASSWORD_AT_LEAST_16_CHARACTERS
GOOGLE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=http://localhost:4000/api/v1/payments/success
PAYMENT_CANCEL_URL=http://localhost:4000/api/v1/payments/cancel
CORS_ORIGINS=http://localhost:3000
# Optional cache; database works without Redis.
REDIS_URL=
# 0 for local direct access; 1 for Render's reverse proxy.
TRUST_PROXY=0
# Used by tests only. Database name must end in _test; tests clear its data.
TEST_DATABASE_URL=
# Used by smoke:live only.
LIVE_API_URL=
