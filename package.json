{
    "name":  "courier-backend",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=22.12.0"
                },
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "prisma generate \u0026\u0026 tsc",
                    "start":  "node dist/src/server.js",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "biome check src tests scripts prisma/seed.ts prisma.config.ts vitest.config.ts",
                    "format":  "biome check --write src tests scripts prisma/seed.ts prisma.config.ts vitest.config.ts",
                    "test":  "vitest run",
                    "test:integration":  "vitest run tests/integration.test.ts",
                    "db:migrate":  "prisma migrate deploy",
                    "db:seed":  "tsx prisma/seed.ts",
                    "docs:generate":  "tsx scripts/generate-docs.ts",
                    "check":  "npm run typecheck \u0026\u0026 npm run lint \u0026\u0026 npm test",
                    "config:check":  "tsx scripts/check-config.ts",
                    "smoke:live":  "tsx scripts/smoke-live.ts",
                    "start:local":  "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
                    "stripe:listen":  "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-stripe.ps1"
                },
    "dependencies":  {
                         "@prisma/adapter-pg":  "^7.0.0",
                         "@prisma/client":  "^7.0.0",
                         "argon2":  "^0.44.0",
                         "cors":  "^2.8.5",
                         "dotenv":  "^17.2.0",
                         "express":  "^5.1.0",
                         "express-rate-limit":  "^8.1.0",
                         "google-auth-library":  "^10.3.0",
                         "helmet":  "^8.1.0",
                         "jsonwebtoken":  "^9.0.2",
                         "pg":  "^8.16.0",
                         "pino":  "^10.0.0",
                         "redis":  "^5.9.0",
                         "stripe":  "^20.0.0",
                         "swagger-ui-express":  "^5.0.1",
                         "zod":  "^4.1.0"
                     },
    "devDependencies":  {
                            "@apidevtools/swagger-parser":  "^13.1.0",
                            "@biomejs/biome":  "^2.3.0",
                            "@types/cors":  "^2.8.19",
                            "@types/express":  "^5.0.0",
                            "@types/jsonwebtoken":  "^9.0.10",
                            "@types/node":  "^24.0.0",
                            "@types/pg":  "^8.15.0",
                            "@types/supertest":  "^6.0.3",
                            "@types/swagger-ui-express":  "^4.1.8",
                            "prisma":  "^7.0.0",
                            "supertest":  "^7.1.0",
                            "tsx":  "^4.20.0",
                            "typescript":  "^5.9.0",
                            "vitest":  "^4.0.0"
                        },
    "overrides":  {
                      "deepmerge-ts":  "^8.0.2",
                      "mysql2":  "^3.24.5"
                  }
}